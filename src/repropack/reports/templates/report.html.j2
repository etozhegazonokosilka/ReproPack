<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReproPack Diagnostic Report</title>
  <style>
    :root {
      color-scheme: light;
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      color: #1e293b;
      background: #f1f5f9;
    }
    body { margin: 0; padding: 2rem; }
    main { max-width: 960px; margin: 0 auto; }
    header { margin-bottom: 1.5rem; }
    h1 { margin: 0; color: #0f172a; font-size: 2rem; }
    h2 { margin-top: 0; font-size: 1.2rem; color: #0f172a; }
    .subtitle { color: #475569; margin: 0.4rem 0 0; }
    section {
      background: #ffffff;
      border: 1px solid #dbe3ef;
      border-radius: 12px;
      box-shadow: 0 1px 2px rgb(15 23 42 / 6%);
      margin-bottom: 1rem;
      padding: 1.25rem;
    }
    dl { display: grid; grid-template-columns: minmax(150px, 220px) 1fr; gap: 0.55rem 1rem; margin: 0; }
    dt { color: #64748b; font-weight: 600; }
    dd { margin: 0; overflow-wrap: anywhere; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border-bottom: 1px solid #e2e8f0; padding: 0.55rem; text-align: left; }
    th { color: #475569; font-size: 0.8rem; text-transform: uppercase; }
    pre { background: #0f172a; border-radius: 8px; color: #dbeafe; margin: 0; overflow-x: auto; padding: 1rem; }
    ul { margin: 0; padding-left: 1.2rem; }
    .notice { color: #64748b; font-style: italic; }
    .security { background: #ecfdf5; border-color: #a7f3d0; }
    code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
    @media (max-width: 640px) {
      body { padding: 1rem; }
      dl { grid-template-columns: 1fr; gap: 0.2rem; }
      dd { margin-bottom: 0.55rem; }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <h1>ReproPack Diagnostic Report</h1>
      <p class="subtitle">Safe environment metadata for reproducible bug reports.</p>
    </header>

    <section>
      <h2>Overview</h2>
      <dl>
        <dt>Generated</dt><dd>{{ report.generated_at }}</dd>
        <dt>ReproPack version</dt><dd>{{ report.repropack_version }}</dd>
        <dt>Report schema</dt><dd>{{ report.schema_version }}</dd>
        <dt>Project</dt><dd>{{ report.project.name }}</dd>
      </dl>
    </section>

    <section>
      <h2>System</h2>
      <dl>
        <dt>Operating system</dt><dd>{{ report.system.os_name }}</dd>
        <dt>Version</dt><dd>{{ report.system.os_version }}</dd>
        <dt>Architecture</dt><dd>{{ report.system.architecture }}</dd>
      </dl>
    </section>

    <section>
      <h2>Python</h2>
      <dl>
        <dt>Version</dt><dd>{{ report.python.version }}</dd>
        <dt>Implementation</dt><dd>{{ report.python.implementation }}</dd>
        <dt>Virtual environment</dt><dd>{{ report.python.in_virtual_environment }}</dd>
      </dl>
    </section>

    <section>
      <h2>Dependencies</h2>
      {% if report.python.packages %}
      <table>
        <thead><tr><th>Package</th><th>Version</th></tr></thead>
        <tbody>
          {% for name, version in report.python.packages|dictsort %}
          <tr><td>{{ name }}</td><td>{{ version }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="notice">No installed packages were reported.</p>
      {% endif %}
    </section>

    <section>
      <h2>Git</h2>
      {% if report.git.is_repository %}
      <dl>
        <dt>Branch</dt><dd>{{ report.git.branch or "Detached HEAD" }}</dd>
        <dt>Commit</dt><dd><code>{{ report.git.commit or "Unavailable" }}</code></dd>
        <dt>Working tree</dt><dd>{{ "Dirty" if report.git.is_dirty else "Clean" }}</dd>
      </dl>
      <h3>Modified files</h3>
      {% if report.git.modified_files %}<ul>{% for path in report.git.modified_files %}<li><code>{{ path }}</code></li>{% endfor %}</ul>{% else %}<p class="notice">None.</p>{% endif %}
      <h3>Untracked files</h3>
      {% if report.git.untracked_files %}<ul>{% for path in report.git.untracked_files %}<li><code>{{ path }}</code></li>{% endfor %}</ul>{% else %}<p class="notice">None.</p>{% endif %}
      {% else %}
      <p class="notice">{{ report.git.unavailable_reason or "Git data is unavailable." }}</p>
      {% endif %}
    </section>

    <section>
      <h2>Project Structure</h2>
      {% if report.project.file_tree %}<pre>{% for path in report.project.file_tree %}{{ path }}
{% endfor %}</pre>{% else %}<p class="notice">No project entries were reported.</p>{% endif %}
    </section>

    <section class="security">
      <h2>Security</h2>
      <p>ReproPack does not read file contents or collect hostnames, usernames, network addresses, Git remotes, or diffs.</p>
      <p>Detected secrets are replaced with <code>{{ redacted_marker }}</code> before rendering.</p>
    </section>
  </main>
</body>
</html>
